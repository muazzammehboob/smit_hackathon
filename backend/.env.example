# ==============================================================================
# Flight Management System Environment Configuration (.env.example)
# Source of truth schema matching project root .env
# ==============================================================================

# Supabase API Connectivity (Supabase SDKs & n8n)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."  # Safe for browser/client (modern 'anon' key)
SUPABASE_SECRET_KEY="sb_secret_..."            # Privileged backend key (modern 'service_role' key)

# Legacy aliases (supported for backward compatibility)
# SUPABASE_ANON_KEY="your-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Direct Database Connection (FastAPI/SQLAlchemy/pgvector)
DATABASE_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres"

# Cloudinary Core Credentials
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# AI / OpenAI API Key
OPENAI_API_KEY="your-openai-api-key"

# CORS Allowed Origins (JSON array or comma-separated string)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","*"]

# n8n Webhook Security Secret
N8N_WEBHOOK_SECRET="hackathon-secret"

# Server Port (used by Render)
PORT=8000
